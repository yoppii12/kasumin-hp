  "depth": 11
 },
 {
  "tag": "p",
  "text": "■ クラウドファンディングに挑戦した理由",
  "box": {
   "x": 424,
   "y": 2495,
   "w": 592,
   "h": 28
  },
  "style": {
   "ff": "Montserrat",
