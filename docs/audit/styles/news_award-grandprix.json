 },
 {
  "tag": "h3",
  "text": "■ 発表のテーマ",
  "box": {
   "x": 424,
   "y": 2040,
   "w": 592,
   "h": 35
  },
  "style": {
   "ff": "Montserrat",
   "fs": "20px",
   "fw": "500",
   "lh": "35px",
   "ls": "0.6px",
   "color": "rgb(51, 51, 51)"
  },
  "depth": 11
 },
 {
  "tag": "strong",
  "text": "「潜在保育士と現場をつなぐマッチングプラットフォーム」",
  "box": {
   "x": 424,
   "y": 2089,
   "w": 440,
   "h": 19
  },
  "style": {
   "ff": "Montserrat",
   "fs": "16px",
   "fw": "700",
   "lh": "25.6px",
   "ls": "0.32px",
   "color": "rgb(51, 51, 51)"
  },
  "depth": 12
 },
 {
  "tag": "p",
  "text": "〜えんまーるが届ける、保育現場への新たな支援のカタチ〜",
  "box": {
   "x": 424,
   "y": 2123,
   "w": 592,
   "h": 28
  },
  "style": {
   "ff": "Montserrat",
   "fs": "16px",
   "fw": "400",
   "lh": "28px",
   "ls": "0.32px",
   "color": "rgb(51, 51, 51)"
  },
  "depth": 11
 },
 {
  "tag": "p",
  "text": "私自身、約10年間の保育士経験の中で、現場の深刻な人手不足や、続けたくても続けられない保育現場の環境課題、復職しても条件が合わず現場を離れていく仲間たちを間近で見てきました。",
  "box": {
   "x": 424,
   "y": 2161,
   "w": 592,
   "h": 84
  },
  "style": {
   "ff": "Montserrat",
   "fs": "16px",
   "fw": "400",
   "lh": "28px",
   "ls": "0.32px",
   "color": "rgb(51, 51, 51)"
  },
  "depth": 11
 },
 {
  "tag": "strong",
  "text": "「保育士が、もっと自分らしく、長く続けられる社会を作りたい。」",
  "box": {
   "x": 424,
   "y": 2259,
   "w": 498,
   "h": 19
  },
  "style": {
   "ff": "Montserrat",
   "fs": "16px",
   "fw": "700",
   "lh": "25.6px",
   "ls": "0.32px",
   "color": "rgb(51, 51, 51)"
  },
  "depth": 12
 },
 {
  "tag": "p",
  "text": "そんな現場出身だからこそ感じるリアルな課題と解決案が、事業の独創性や社会貢献性の面で高く評価され、今回の受賞に繋がりました。",
  "box": {
   "x": 424,
   "y": 2293,
   "w": 592,
   "h": 56
  },
  "style": {
   "ff": "Montserrat",
   "fs": "16px",
   "fw": "400",
   "lh": "28px",
   "ls": "0.32px",
   "color": "rgb(51, 51, 51)"
  },
  "depth": 11
 },
 {
  "tag": "p",
  "text": "「新聞記事ではマッチングの仕組みを大きく取り上げていただきましたが、私がこの事業を通じて本当に実現したいのは、です。そのために、まずは保育士さんが笑顔で働ける環境を整えていきたいと考えています。」",
  "box": {
   "x": 424,
   "y": 2359,
   "w": 592,
   "h": 112
  },
  "style": {
   "ff": "Montserrat",
   "fs": "16px",
   "fw": "400",
   "lh": "28px",
   "ls": "0.32px",
   "color": "rgb(51, 51, 51)"
  },
  "depth": 11
 },
 {
  "tag": "strong",
  "text": "子どもたちが大人になるために、えんまーるで必要な手をしっかりと届け、安全と笑顔を守ること",
  "box": {
   "x": 424,
   "y": 2391,
   "w": 587,
   "h": 47
  },
  "style": {
   "ff": "Montserrat",
   "fs": "16px",
   "fw": "700",
   "lh": "25.6px",
   "ls": "0.32px",
   "color": "rgb(51, 51, 51)"
  },
  "depth": 12
 },
 {
  "tag": "img",
  "src": "https://storage.googleapis.com/studio-design-asset-files/projects/bXqzew1ZOD/s-1108x1477_v-fms_webp_612b91cb-4779-4b0a-9416-2d3e6585a44a_middle.webp",
  "box": {
   "x": 424,
   "y": 2537,
   "w": 592,
   "h": 789
  },
  "style": {
   "ff": "sans-serif",
   "fs": "16px",
   "fw": "400",
   "lh": "16px",
   "ls": "0.32px",
   "color": "rgb(51, 51, 51)"
  },
  "depth": 12
 },
 {
  "tag": "h3",
  "text": "■ これからの展望",
  "box": {
   "x": 424,
   "y": 3428,
   "w": 592,
   "h": 35
  },
  "style": {
   "ff": "Montserrat",
   "fs": "20px",
   "fw": "500",
   "lh": "35px",
   "ls": "0.6px",
   "color": "rgb(51, 51, 51)"
  },
  "depth": 11
 },
 {
  "tag": "p",
  "text": "今回の受賞は、私にとっても大きなスタートラインです。 この事業を通じて、長崎の保育現場をより明るく、持続可能なものに変えていくために、これから本格的なサービス展開に向けて準備を加速させてまいります。",
  "box": {
   "x": 424,
   "y": 3473,
   "w": 592,
   "h": 84
  },
  "style": {
   "ff": "Montserrat",
   "fs": "16px",
   "fw": "400",
   "lh": "28px",
   "ls": "0.32px",
   "color": "rgb(51, 51, 51)"
  },
  "depth": 11
 },
 {
  "tag": "p",
  "text": "共に切磋琢磨した5期生の仲間、支えてくださったメンターの皆様、そして日々応援してくださる皆様に、心より感謝申し上げます。",
  "box": {
   "x": 424,
   "y": 3567,
   "w": 592,
   "h": 56
  },
  "style": {
   "ff": "Montserrat",
   "fs": "16px",
   "fw": "400",
   "lh": "28px",
   "ls": "0.32px",
   "color": "rgb(51, 51, 51)"
  },
  "depth": 11
 },
 {
  "tag": "h3",
  "text": "💡 サービス開始に向けて、皆様の声を募集中です",
  "box": {
   "x": 424,
   "y": 3655,
   "w": 592,
   "h": 35
  },
  "style": {
   "ff": "Montserrat",
   "fs": "20px",
   "fw": "500",
   "lh": "35px",
   "ls": "0.6px",
   "color": "rgb(51, 51, 51)"
  },
  "depth": 11
 },
 {
  "tag": "p",
  "text": "私たちは「現場のリアルな声」を一番大切にしたいと考えています。本格稼働に向けて、ぜひあなたの想いや悩みを聞かせてください。",
  "box": {
   "x": 424,
   "y": 3700,
   "w": 592,
   "h": 56
  },
  "style": {
   "ff": "Montserrat",
   "fs": "16px",
   "fw": "400",
   "lh": "28px",
   "ls": "0.32px",
   "color": "rgb(51, 51, 51)"
  },
  "depth": 11
 },
 {
  "tag": "p",
  "text": "「現状の採用ではうまくいかない」「現場の負担を本気で減らしたい」とお考えの園様、ぜひ一度意見交換をさせていただけませんか？",
  "box": {
   "x": 444,
   "y": 3766,
   "w": 572,
   "h": 84
  },
  "style": {
   "ff": "Montserrat",
   "fs": "16px",
   "fw": "400",
   "lh": "28px",
   "ls": "0.32px",
   "color": "rgb(51, 51, 51)"
  },
  "depth": 13
 },
 {
  "tag": "strong",
  "text": "【保育園・施設の関係者様へ】",
  "box": {
   "x": 444,
   "y": 3770,
   "w": 228,
   "h": 19
  },
  "style": {
   "ff": "Montserrat",
   "fs": "16px",
   "fw": "700",
   "lh": "25.6px",
   "ls": "0.32px",
   "color": "rgb(51, 51, 51)"
  },
  "depth": 14
 },
 {
  "tag": "p",
  "text": "「こんな働き方ができたら復帰したい」「資格を活かしてこんなことに挑戦したい」というお声を、ぜひお聞かせください！",
  "box": {
   "x": 444,
   "y": 3860,
   "w": 572,
   "h": 56
  },
  "style": {
   "ff": "Montserrat",
   "fs": "16px",
   "fw": "400",
   "lh": "28px",
   "ls": "0.32px",
   "color": "rgb(51, 51, 51)"
  },
  "depth": 13
 },
 {
  "tag": "strong",
  "text": "【保育士の皆様へ】",
  "box": {
   "x": 444,
   "y": 3864,
   "w": 147,
   "h": 19
  },
  "style": {
   "ff": "Montserrat",
   "fs": "16px",
   "fw": "700",
   "lh": "25.6px",
   "ls": "0.32px",
   "color": "rgb(51, 51, 51)"
  },
  "depth": 14
 },
 {
  "tag": "p",
  "text": "公式LINEでは、サービス開始のお知らせや、代表・平田への直接のメッセージも受け付けています。",
  "box": {
